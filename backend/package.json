{
  "name": "street-sorted-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src tests",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "cd .. && npm run test:e2e",
    "build": "tsc",
    "dev:mock-target": "tsx src/dev/mock-target-server.ts"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "axios-cookiejar-support": "^6.0.4",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "tough-cookie": "^5.1.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@playwright/test": "^1.52.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.2",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.23.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0",
    "vitest": "^3.1.2"
  }
}
