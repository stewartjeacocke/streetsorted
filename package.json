{
  "name": "street-sorted",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server/dev-server.ts",
    "dev:mock-target": "tsx src/server/dev/mock-target-server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -p tsconfig.client.json && tsx src/server/dev/client-build.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server.js",
    "test": "npm run test:server && npm run test:client",
    "test:server": "tsx --test tests/server/**/*.test.ts",
    "test:client": "tsx --test --import=./src/client/test/setup.ts src/client/**/*.test.ts src/client/**/*.test.tsx",
    "test:contract": "tsx --test tests/server/contract/*.test.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "lint": "eslint src tests",
    "format": "prettier --check ."
  },
  "dependencies": {
    "axios": "^1.8.4",
    "axios-cookiejar-support": "^6.0.4",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tough-cookie": "^5.1.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.7.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
