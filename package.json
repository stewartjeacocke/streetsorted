{
  "name": "street-sorted",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server/dev-server.ts",
    "dev:mock-target": "tsx src/server/dev/mock-target-server.ts",
    "build": "npm run build:server && npm run build:assets",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server.js",
    "test": "npm run test:server",
    "test:server": "tsx --test tests/server/**/*.test.ts",
    "test:contract": "tsx --test tests/server/contract/*.test.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "lint": "eslint src tests",
    "format": "prettier --check .",
    "build:assets": "tsx src/server/dev/static-assets.ts"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "axios-cookiejar-support": "^6.0.4",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "tough-cookie": "^5.1.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.52.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^26.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.0",
    "prettier": "^3.7.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
