{
  "name": "street-sorted",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names client,server --prefix-colors blue,green \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite --host 127.0.0.1 --port 4000",
    "dev:server": "tsx watch src/server/server.ts",
    "dev:mock-target": "tsx src/server/dev/mock-target-server.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json && vite build",
    "start": "node dist/server/server.js",
    "test": "npm run test:server && npm run test:client",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:contract": "vitest run --config vitest.server.config.ts tests/server/contract",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "lint": "eslint src tests",
    "format": "prettier --check ."
  },
  "dependencies": {
    "axios": "^1.8.4",
    "axios-cookiejar-support": "^6.0.4",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tough-cookie": "^5.1.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.7.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
